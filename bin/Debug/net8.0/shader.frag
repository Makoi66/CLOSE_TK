#version 460 core // Указываем версию OpenGL

// Выходная переменная - итоговый цвет пикселя
out vec4 FragColor;

// Входная переменная - интерполированные текстурные координаты из вершинного шейдера
// Имя (TexCoords) должно совпадать с именем out-переменной в вершинном шейдере.
in vec2 TexCoords;

// Uniform-переменная для текстуры (семплер)
// "texture0" должно совпадать с именем, которое ты используешь
// при получении location через GL.GetUniformLocation в C#
uniform sampler2D texture0;

void main()
{
    // Получаем цвет из текстуры в точке, соответствующей
    // интерполированным текстурным координатам TexCoords
    FragColor = texture(texture0, TexCoords);

    // Если хочешь добавить базовый цвет (например, для отладки):
    // FragColor = vec4(1.0, 0.0, 0.0, 1.0); // Красный цвет
    // FragColor = texture(texture0, TexCoords) * vec4(1.0, 0.5, 0.5, 1.0); // Текстура с красным оттенком
}